# Database (Docker Compose maps host 5434 → container 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/week3_rag

# Provider: qwen | openai | gemini | ollama
# qwen: chat via VPS; embeddings via Ollama
# gemini / openai: chat + embeddings via that API
# ollama: chat + embeddings locally
LLM_PROVIDER=qwen
QWEN_BASE_URL=https://203.55.176.215.sslip.io/v1
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen3-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG settings
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
