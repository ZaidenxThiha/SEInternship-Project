# Leave empty for local dev (Vite proxy forwards /api to localhost:3000)
# VITE_API_URL=

# Active chat provider for the UI: qwen | openai | gemini
# (ollama is not used by the browser chat — use week3/4 for that)
LLM_PROVIDER=qwen
VITE_LLM_PROVIDER=qwen

# Qwen VPS (OpenAI-compatible). Keys must NOT use a VITE_ prefix.
QWEN_BASE_URL=https://203.55.176.215.sslip.io
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen3-chat
VITE_QWEN_CHAT_MODEL=qwen3-chat

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
VITE_OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini (OpenAI-compatible endpoint)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
VITE_GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
